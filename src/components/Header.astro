---
import { navigation, siteConfig } from '../data/site';
import { withBase } from '../utils/site';
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath.startsWith(withBase(href)) ||
  (href === '/posts/' && currentPath.startsWith(withBase('/tags/')));
---

<header class="site-header" data-pagefind-ignore>
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${siteConfig.name}首页`}>{siteConfig.name}</a
    >
    <nav class="site-nav" aria-label="主导航">
      {
        navigation.map((item) => (
          <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={withBase('/search/')} aria-current={isActive('/search/') ? 'page' : undefined}
        >搜索</a
      >
    </nav>
  </div>
</header>
