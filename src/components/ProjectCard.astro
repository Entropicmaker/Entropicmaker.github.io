---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<section class="project-entry">
  <h2>
    {
      project.href ? (
        <a href={project.href} target="_blank" rel="noopener noreferrer">
          {project.title} ↗
        </a>
      ) : (
        project.title
      )
    }
  </h2>
  <p class="entry-meta">{project.year} · {project.status} · {project.category}</p>
  <p>{project.description}</p>
  <p>{project.outcome}</p>
  <p class="entry-meta">{project.stack.join(' / ')}</p>
</section>
