<script>
  const sourceBlocks = Array.from(
    document.querySelectorAll<HTMLElement>(
      '.article-content pre[data-language="mermaid"] > code, .article-content pre > code.language-mermaid'
    )
  );

  if (sourceBlocks.length > 0) {
    void (async () => {
      try {
        const { default: mermaid } = await import('mermaid');
        const diagrams = sourceBlocks.flatMap((code, index) => {
          const source = code.textContent?.trim();
          const original = code.closest('pre');
          if (!source || !original) return [];

          const figure = document.createElement('figure');
          const viewport = document.createElement('div');
          figure.className = 'mermaid-diagram';
          viewport.className = 'mermaid-viewport';
          viewport.setAttribute('role', 'img');
          viewport.setAttribute('aria-label', `文章关系图 ${index + 1}`);
          viewport.setAttribute('aria-busy', 'true');
          figure.append(viewport);
          original.replaceWith(figure);

          return [{ source, original, viewport, index }];
        });

        let renderGeneration = 0;

        const renderDiagrams = async () => {
          const generation = ++renderGeneration;
          const dark = document.documentElement.dataset.theme === 'dark';

          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            suppressErrorRendering: true,
            theme: 'base',
            themeVariables: dark
              ? {
                  darkMode: true,
                  background: '#132124',
                  primaryColor: '#26382d',
                  primaryTextColor: '#e8ece7',
                  primaryBorderColor: '#93b09a',
                  lineColor: '#9daead',
                  secondaryColor: '#1e3438',
                  tertiaryColor: '#192a2d',
                  fontFamily:
                    'ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif'
                }
              : {
                  darkMode: false,
                  background: '#ffffff',
                  primaryColor: '#e3ece1',
                  primaryTextColor: '#183034',
                  primaryBorderColor: '#5b7f65',
                  lineColor: '#667679',
                  secondaryColor: '#dcebec',
                  tertiaryColor: '#f1f4f1',
                  fontFamily:
                    'ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif'
                },
            flowchart: {
              htmlLabels: false,
              useMaxWidth: true
            }
          });

          for (const diagram of diagrams) {
            try {
              const id = `mermaid-diagram-${diagram.index}-${generation}`;
              const { svg, bindFunctions } = await mermaid.render(id, diagram.source);
              if (generation !== renderGeneration) return;

              diagram.viewport.innerHTML = svg;
              diagram.viewport.setAttribute('aria-busy', 'false');
              const renderedSvg = diagram.viewport.querySelector('svg');
              renderedSvg?.setAttribute('role', 'img');
              renderedSvg?.setAttribute('aria-label', `文章关系图 ${diagram.index + 1}`);
              bindFunctions?.(diagram.viewport);
            } catch (error) {
              if (generation !== renderGeneration) return;
              diagram.viewport.replaceChildren(diagram.original.cloneNode(true));
              diagram.viewport.classList.add('has-render-error');
              diagram.viewport.setAttribute(
                'aria-label',
                `文章关系图 ${diagram.index + 1}渲染失败，显示源码`
              );
              diagram.viewport.setAttribute('aria-busy', 'false');
              console.error('Mermaid 关系图渲染失败', error);
            }
          }
        };

        await renderDiagrams();

        const themeObserver = new MutationObserver((records) => {
          if (records.some((record) => record.attributeName === 'data-theme')) {
            void renderDiagrams();
          }
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme']
        });
      } catch (error) {
        console.error('Mermaid 渲染器加载失败', error);
      }
    })();
  }
</script>
