---
import HomeFeed from './HomeFeed.astro';
import { getHomeFields } from '../utils/home';
import type { Post } from '../utils/posts';
import { withBase } from '../utils/site';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const fields = getHomeFields(posts);
---

<div
  id="geo-design"
  class="geo-screen"
  data-design-version="v009"
  data-fields={JSON.stringify(fields.map(({ articles, ...field }) => field))}
>
  <div class="geo-content shell">
    <section class="geo-hero" aria-labelledby="home-title">
      <div class="geo-introduction">
        <p class="geo-eyebrow">
          <span class="geo-dot"></span>FIELD JOURNAL / {new Date().getFullYear()}
        </p>
        <h1 id="home-title" class="geo-headline" tabindex="-1" aria-label="Linzii的地理小站">
          <span class="geo-text-window"><span>Linzii的</span></span><span class="geo-text-window"
            ><span><em>地理</em>小站</span></span
          >
        </h1>
        <p class="geo-subtitle">地理专业学生，记录空间、代码与日常。</p>
      </div>
      <div class="geo-instrument" role="img" aria-label="经纬曲线、观测圆环与定位点组成的地理图形">
        <canvas class="geo-art" aria-hidden="true"></canvas>
        <span class="geo-instrument-label">OBSERVATION / SPACE</span>
      </div>
    </section>
    <section class="geo-reading" aria-labelledby="reading-title">
      <div class="home-section-heading">
        <h2 id="reading-title">文章与记录</h2><a href={withBase('/posts/')}
          >全部文章 <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="geo-article-layout">
        <aside class="geo-sidebar" aria-label="内容坐标">
          <div class="geo-filter-controls" hidden>
            <div class="geo-nav-heading">
              <h3>内容坐标</h3><button
                class="geo-all"
                data-category="0"
                aria-pressed="true"
                type="button">全部记录 <span>{fields[0].count}</span></button
              >
            </div>
            <div class="geo-filters" role="group" aria-label="按内容坐标筛选文章">
              {
                fields.slice(1).map((field, index) => (
                  <button
                    class="geo-category"
                    data-category={index + 1}
                    aria-pressed="false"
                    type="button"
                  >
                    <>
                      <span class="geo-filter-name">
                        <>
                          <span class="geo-mono">{field.number}</span>
                          <span class="geo-filter-title">{field.name}</span>
                        </>
                      </span>
                      <span class="geo-filter-count" aria-label={`${field.count}篇文章`}>
                        {field.count}
                      </span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
          <noscript
            ><nav class="geo-category-fallback" aria-label="内容分类">
              {fields.map((field) => <a href={field.href}>{field.name}</a>)}
            </nav></noscript
          >
          <a class="geo-category-overview" href={withBase('/categories/')}
            >分类总览 <span aria-hidden="true">↗</span></a
          >
        </aside>
        <div class="geo-results" role="region" aria-label="文章列表" aria-busy="false">
          <HomeFeed field={fields[0]} />
        </div>
      </div>
      <p class="sr-only geo-filter-status" role="status" aria-live="polite" data-pagefind-ignore>
      </p>
    </section>
    <div class="geo-rule" aria-hidden="true"></div>
  </div>
  {
    fields.map((field, index) => (
      <template data-home-view={index} data-pagefind-ignore>
        <HomeFeed field={field} />
      </template>
    ))
  }
  <div
    class="geo-entry"
    role="dialog"
    aria-modal="true"
    aria-label="Linzii的地理小站入场动画"
    tabindex="-1"
    hidden
    data-pagefind-ignore
  >
    <div class="geo-entry-composition" aria-hidden="true">
      <canvas class="geo-entry-art"></canvas><div class="geo-entry-big">
        <span class="geo-entry-line">FIELD</span><span class="geo-entry-line">JOURNAL</span>
      </div><canvas class="geo-entry-front"></canvas>
      <div class="geo-entry-identity">
        <span class="geo-entry-kicker"><span>GEOGRAPHY / COMPUTING / EVERYDAY</span></span><strong
          class="geo-entry-title"><span>Linzii的</span><span>地理小站</span></strong
        >
      </div>
    </div>
    <div class="geo-entry-inverse" aria-hidden="true">
      <canvas class="geo-entry-art"></canvas><div class="geo-entry-big">
        <span class="geo-entry-line">FIELD</span><span class="geo-entry-line">JOURNAL</span>
      </div><canvas class="geo-entry-front"></canvas>
      <div class="geo-entry-identity">
        <span class="geo-entry-kicker"><span>GEOGRAPHY / COMPUTING / EVERYDAY</span></span><strong
          class="geo-entry-title"><span>Linzii的</span><span>地理小站</span></strong
        >
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/coordinate-home.js';
</script>
