---
import { withBase } from '../utils/site';
import type { CoursewareSlide } from '../data/courseware-vcmax';

interface Props {
  slides: CoursewareSlide[];
  deckTitle: string;
  /** public/ 下的目录，末尾不加斜杠 */
  dir?: string;
}

const { slides, deckTitle, dir = '/slides/vcmax-courseware' } = Astro.props;
const total = slides.length;
const pad = (n: number) => String(n).padStart(2, '0');
const srcOf = (n: number) => withBase(`${dir}/slide-${pad(n)}.webp`);
const thumbOf = (n: number) => withBase(`${dir}/thumb-${pad(n)}.webp`);
---

<section class="slide-deck" data-slide-deck aria-label={`${deckTitle}（共 ${total} 页）`}>
  <div class="deck-toolbar" data-deck-toolbar hidden>
    <div class="deck-nav">
      <button type="button" class="deck-btn" data-deck-prev aria-label="上一页">←</button>
      <output class="deck-counter" data-deck-counter aria-live="polite">{`1 / ${total}`}</output>
      <button type="button" class="deck-btn" data-deck-next aria-label="下一页">→</button>
    </div>
    <div class="deck-tools">
      <button
        type="button"
        class="deck-btn deck-btn-wide"
        data-deck-toggle-thumbs
        aria-expanded="false"
        aria-controls="deck-thumbs">缩略图</button
      >
      <button type="button" class="deck-btn deck-btn-wide" data-deck-fullscreen>全屏</button>
    </div>
  </div>

  <ol
    class="deck-stage"
    data-deck-stage
    tabindex="0"
    role="group"
    aria-label={`${deckTitle} 幻灯片，可用左右方向键翻页`}
  >
    {
      slides.map((slide, index) => (
        <li class="deck-slide" data-deck-slide data-index={index}>
          <figure>
            <a
              class="deck-link"
              href={srcOf(slide.n)}
              target="_blank"
              rel="noopener"
              aria-label={`第 ${slide.n} 页：${slide.title}（在新标签页打开原图）`}
            >
              <img
                src={srcOf(slide.n)}
                alt={`第 ${slide.n} 页：${slide.title}`}
                width="1600"
                height="900"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </a>
            <figcaption>
              <span class="deck-fig-n">{slide.n}</span>
              <span>{slide.title}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ol>

  <div class="deck-thumbs" id="deck-thumbs" data-deck-thumbs hidden>
    <ol>
      {
        slides.map((slide, index) => (
          <li>
            <button
              type="button"
              class="deck-thumb"
              data-deck-thumb
              data-index={index}
              aria-label={`跳到第 ${slide.n} 页：${slide.title}`}
            >
              <img src={thumbOf(slide.n)} alt="" width="360" height="203" loading="lazy" decoding="async" />
              <span>{slide.n}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="deck-hint" data-deck-hint hidden>
    点击幻灯片可查看原图；键盘 <kbd>←</kbd> <kbd>→</kbd> 翻页，<kbd>Home</kbd> <kbd>End</kbd> 跳转首尾。
  </p>
</section>

<script>
  interface DeckElements {
    root: HTMLElement;
    stage: HTMLElement;
    toolbar: HTMLElement;
    counter: HTMLOutputElement;
    hint: HTMLElement;
    thumbsPanel: HTMLElement;
    thumbsToggle: HTMLButtonElement;
    slides: HTMLElement[];
    thumbs: HTMLButtonElement[];
    prev: HTMLButtonElement;
    next: HTMLButtonElement;
  }

  const decks = Array.from(document.querySelectorAll<HTMLElement>('[data-slide-deck]'));

  decks.forEach((root) => {
    const q = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector);
    const qa = <T extends HTMLElement>(selector: string) => Array.from(root.querySelectorAll<T>(selector));

    const stage = q<HTMLElement>('[data-deck-stage]');
    const toolbar = q<HTMLElement>('[data-deck-toolbar]');
    const counter = q<HTMLOutputElement>('[data-deck-counter]');
    const hint = q<HTMLElement>('[data-deck-hint]');
    const thumbsPanel = q<HTMLElement>('[data-deck-thumbs]');
    const thumbsToggle = q<HTMLButtonElement>('[data-deck-toggle-thumbs]');
    const prev = q<HTMLButtonElement>('[data-deck-prev]');
    const next = q<HTMLButtonElement>('[data-deck-next]');
    const fullscreen = q<HTMLButtonElement>('[data-deck-fullscreen]');

    if (!stage || !toolbar || !counter) return;

    const deck: DeckElements = {
      root,
      stage,
      toolbar,
      counter,
      hint: hint as HTMLElement,
      thumbsPanel: thumbsPanel as HTMLElement,
      thumbsToggle: thumbsToggle as HTMLButtonElement,
      prev: prev as HTMLButtonElement,
      next: next as HTMLButtonElement,
      slides: qa<HTMLElement>('[data-deck-slide]'),
      thumbs: qa<HTMLButtonElement>('[data-deck-thumb]')
    };

    const total = deck.slides.length;
    if (total === 0) return;

    let current = 0;

    const go = (index: number, options: { scroll?: boolean; focus?: boolean } = {}) => {
      const next = Math.min(total - 1, Math.max(0, index));
      current = next;

      deck.slides.forEach((slide, i) => {
        const active = i === next;
        if (active) slide.setAttribute('data-active', '');
        else slide.removeAttribute('data-active');
      });

      deck.thumbs.forEach((thumb, i) => {
        if (i === next) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });

      deck.counter.value = `${next + 1} / ${total}`;
      deck.prev.disabled = next === 0;
      deck.next.disabled = next === total - 1;

      if (options.scroll) {
        const active = deck.slides[next].querySelector('figure');
        active?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      if (options.focus) stage.focus({ preventScroll: true });
    };

    const openThumbs = (open: boolean) => {
      if (!deck.thumbsPanel || !deck.thumbsToggle) return;
      deck.thumbsPanel.hidden = !open;
      deck.thumbsToggle.setAttribute('aria-expanded', String(open));
      deck.thumbsToggle.textContent = open ? '收起缩略图' : '缩略图';
    };

    // 进入增强模式：默认（无 JS）是全部平铺的静态长图
    root.setAttribute('data-ready', '');
    deck.toolbar.hidden = false;
    if (deck.hint) deck.hint.hidden = false;

    deck.prev?.addEventListener('click', () => go(current - 1));
    deck.next?.addEventListener('click', () => go(current + 1));
    deck.thumbsToggle?.addEventListener('click', () => openThumbs(deck.thumbsPanel.hidden));

    deck.thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = Number(thumb.dataset.index ?? 0);
        go(index, { scroll: true });
        openThumbs(false);
      });
    });

    fullscreen?.addEventListener('click', () => {
      const active = deck.slides[current].querySelector('figure');
      if (!active) return;
      if (document.fullscreenElement) void document.exitFullscreen();
      else void active.requestFullscreen?.();
    });

    // 仅在组件获得焦点时接管方向键，避免影响页面正常滚动
    stage.addEventListener('keydown', (event) => {
      switch (event.key) {
        case 'ArrowLeft':
        case 'ArrowUp':
          event.preventDefault();
          go(current - 1);
          break;
        case 'ArrowRight':
        case 'ArrowDown':
        case ' ':
        case 'PageDown':
          event.preventDefault();
          go(current + 1);
          break;
        case 'PageUp':
          event.preventDefault();
          go(current - 1);
          break;
        case 'Home':
          event.preventDefault();
          go(0);
          break;
        case 'End':
          event.preventDefault();
          go(total - 1);
          break;
        default:
          break;
      }
    });

    // 触屏滑动翻页
    let touchStartX = 0;
    let touchStartY = 0;
    stage.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true }
    );
    stage.addEventListener(
      'touchend',
      (event) => {
        const touch = event.changedTouches[0];
        const dx = touch.clientX - touchStartX;
        const dy = touch.clientY - touchStartY;
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
        go(dx < 0 ? current + 1 : current - 1);
      },
      { passive: true }
    );

    go(0);
  });
</script>
