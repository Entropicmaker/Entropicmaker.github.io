---
import { categories } from '../../data/categories';
import IndexRedirect from '../../components/IndexRedirect.astro';
import { withBase } from '../../utils/site';
export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props;
---

<IndexRedirect href={withBase(`/posts/#${category.id}`)} label={category.name} />
