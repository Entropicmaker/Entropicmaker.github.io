---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPublishedPosts, tagToSlug, type Post } from '../../utils/posts';
import { withBase } from '../../utils/site';
export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('posts'));
  return getAllTags(posts).map((tag) => ({
    params: { tag: tagToSlug(tag.name) },
    props: { tag: tag.name, posts: posts.filter((post) => post.data.tags.includes(tag.name)) }
  }));
}
interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
---

<PageLayout title={`标签：${tag}`} description={`共 ${posts.length} 篇文章。`}>
  <PostList posts={posts} />
  <p class="index-links">
    <a href={withBase('/tags/')}>所有标签</a> · <a href={withBase('/posts/')}>文章目录</a>
  </p>
</PageLayout>
