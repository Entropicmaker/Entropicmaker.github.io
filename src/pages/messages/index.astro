---
import { messages } from '../../data/messages';
import PageLayout from '../../layouts/PageLayout.astro';

const sortedMessages = [...messages].sort((a, b) => b.date.localeCompare(a.date));
const formatMessageDate = (date: string) => date.replaceAll('-', '.');
---

<PageLayout title="留言栏" description="记录每天偶然想到的一句话。" eyebrow="Daily Fragments">
  <section class="message-board" aria-label="每日留言">
    {
      sortedMessages.length > 0 ? (
        <ol class="message-list">
          {sortedMessages.map((message) => (
            <li class="message-entry">
              <time datetime={message.date}>{formatMessageDate(message.date)}</time>
              <p>{message.content}</p>
            </li>
          ))}
        </ol>
      ) : (
        <div class="message-empty">
          <p class="eyebrow">Waiting For A Thought</p>
          <h2>这里还没有留言</h2>
          <p>第一句话会在这里出现。</p>
        </div>
      )
    }
  </section>
</PageLayout>
