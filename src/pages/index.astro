---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoordinateHome from '../components/CoordinateHome.astro';
import '../styles/coordinate-home.css';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { getAllTags, getPublishedPosts, tagToSlug } from '../utils/posts';
import { withBase } from '../utils/site';

const posts = getPublishedPosts(await getCollection('posts'));
const tags = getAllTags(posts).slice(0, 12);
---

<BaseLayout title="Linzii的地理小站" bodyClass="home-journal">
  <Fragment slot="head">
    <link
      rel="preload"
      href={withBase('/fonts/barlow-condensed-500.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        try {
          if (
            !matchMedia('(prefers-reduced-motion: reduce)').matches &&
            !sessionStorage.getItem('linzii-entry-seen')
          ) {
            document.documentElement.dataset.homeEntry = 'pending';
            setTimeout(() => {
              delete document.documentElement.dataset.homeEntry;
            }, 5000);
          }
        } catch {}
      })();
    </script>
  </Fragment>
  <CoordinateHome posts={posts} />

  <section class="section shell" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Recent Notes</p>
        <h2 id="latest-title">最新文章</h2>
      </div>
      <a href={withBase('/posts/')}>查看全部文章 →</a>
    </div>
    <div class="post-grid">
      {posts.slice(0, 4).map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="section shell" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From Question To Practice</p>
        <h2 id="projects-title">近期项目</h2>
      </div>
      <a href={withBase('/projects/')}>查看项目档案 →</a>
    </div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section shell" aria-labelledby="tags-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Index By Topic</p>
        <h2 id="tags-title">热门标签</h2>
      </div>
      <a href={withBase('/tags/')}>全部标签 →</a>
    </div>
    <div class="tag-cloud">
      {
        tags.map((tag) => (
          <a
            href={withBase(`/tags/${tagToSlug(tag.name)}/`)}
            style={`--tag-weight: ${Math.min(tag.count, 4)}`}
          >
            {tag.name} <small>{tag.count}</small>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
