---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleIndex from '../components/ArticleIndex.astro';
import { siteConfig } from '../data/site';
import { getPublishedPosts } from '../utils/posts';
const posts = getPublishedPosts(await getCollection('posts'));
---

<BaseLayout>
  <div class="shell page-shell">
    <header class="page-heading">
      <h1>Linzii的<span class="title-accent">地理</span>小站</h1>
      <p>{siteConfig.intro}。</p>
    </header>
    <ArticleIndex posts={posts} />
  </div>
</BaseLayout>
