---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="搜索" description="搜索文章标题与正文。">
  <section class="search-panel" aria-label="站内搜索">
    <form class="search-form" id="search-form" role="search">
      <label class="sr-only" for="search-input">搜索关键词</label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="例如：遥感、光合作用、论文阅读"
        autocomplete="off"
      />
      <button class="button" type="submit">搜索</button>
    </form>
    <p class="search-status" id="search-status" aria-live="polite">输入关键词开始搜索。</p>
    <div class="search-results" id="search-results"></div>
  </section>
</PageLayout>

<script>
  import { searchEntries, type SearchEntry } from '../../utils/search';
  const base = import.meta.env.BASE_URL;
  const form = document.querySelector<HTMLFormElement>('#search-form');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const container = document.querySelector<HTMLElement>('#search-results');
  let indexPromise: Promise<SearchEntry[]> | undefined;
  let generation = 0;

  const escapeHtml = (value: string) => {
    const element = document.createElement('span');
    element.textContent = value;
    return element.innerHTML;
  };
  const resultUrl = (url: string, query: string) => {
    const target = new URL(url, window.location.origin);
    if (!target.pathname.startsWith(base))
      target.pathname = `${base}${target.pathname.replace(/^\/+/, '')}`;
    const source = new URL(window.location.href);
    source.searchParams.set('q', query);
    target.searchParams.set('from', source.pathname + source.search);
    return escapeHtml(target.pathname + target.search + target.hash);
  };
  const runSearch = async (query: string) => {
    const request = ++generation;
    if (!status || !container) return;
    container.innerHTML = '';
    if (!query.trim()) {
      status.textContent = '输入关键词开始搜索。';
      return;
    }
    status.textContent = '正在搜索…';
    try {
      let results: { title: string; url: string; excerpt: string }[] = [];
      let count = 0;
      if (!/[\u3400-\u9fff]/.test(query)) {
        try {
          const pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
          const search = await pagefind.search(query);
          count = search.results.length;
          const matches = await Promise.all(
            search.results
              .slice(0, 20)
              .map(
                (result: {
                  data: () => Promise<{ meta: { title: string }; url: string; excerpt: string }>;
                }) => result.data()
              )
          );
          results = matches.map((result) => ({
            title: result.meta.title || '无标题',
            url: result.url,
            excerpt: result.excerpt
          }));
        } catch {
          /* Fall back to the published article index. */
        }
      }
      if (results.length === 0) {
        indexPromise ??= fetch(`${base}search-index.json`)
          .then((response) => {
            if (!response.ok) throw new Error('Search index unavailable');
            return response.json();
          })
          .catch((error) => {
            indexPromise = undefined;
            throw error;
          });
        const matches = searchEntries(await indexPromise, query);
        count = matches.length;
        results = matches
          .slice(0, 20)
          .map((result) => ({ ...result, excerpt: escapeHtml(result.excerpt) }));
      }
      if (request !== generation) return;
      status.textContent = `找到 ${count} 条结果。`;
      container.innerHTML = results
        .map(
          (result) => `
        <article class="search-result">
          <h2><a href="${resultUrl(result.url, query)}">${escapeHtml(result.title)}</a></h2>
          <p>${result.excerpt}</p>
        </article>`
        )
        .join('');
    } catch {
      if (request !== generation) return;
      status.textContent = '搜索暂时不可用，请稍后重试，或从文章目录查找。';
    }
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value || '';
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    void runSearch(query);
  });
  const initial = new URLSearchParams(window.location.search).get('q') || '';
  if (input) input.value = initial;
  if (initial) void runSearch(initial);
</script>
