---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="搜索" description="搜索文章标题与正文。">
  <section class="search-panel" aria-label="站内搜索">
    <form class="search-form" id="search-form" role="search">
      <label class="sr-only" for="search-input">搜索关键词</label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="例如：遥感、光合作用、论文阅读"
        autocomplete="off"
      />
      <button class="button" type="submit">搜索</button>
    </form>
    <p class="search-status" id="search-status" aria-live="polite">输入关键词开始搜索。</p>
    <div class="search-results" id="search-results"></div>
    <nav class="search-pagination" id="search-pagination" aria-label="搜索结果分页" hidden></nav>
  </section>
</PageLayout>

<script>
  import { searchEntries, type SearchEntry } from '../../utils/search';
  import { paginateResults } from '../../utils/pagination';
  const base = import.meta.env.BASE_URL;
  const form = document.querySelector<HTMLFormElement>('#search-form');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const container = document.querySelector<HTMLElement>('#search-results');
  const pager = document.querySelector<HTMLElement>('#search-pagination');
  type SearchMatch = {
    data: () => Promise<{ meta: { title: string }; url: string; excerpt: string }>;
  };
  let indexPromise: Promise<SearchEntry[]> | undefined;
  let generation = 0;

  const escapeHtml = (value: string) => {
    const element = document.createElement('span');
    element.textContent = value;
    return element.innerHTML;
  };
  const resultUrl = (url: string, query: string) => {
    const target = new URL(url, window.location.origin);
    if (!target.pathname.startsWith(base))
      target.pathname = `${base}${target.pathname.replace(/^\/+/, '')}`;
    const source = new URL(window.location.href);
    source.searchParams.set('q', query);
    target.searchParams.set('from', source.pathname + source.search);
    return escapeHtml(target.pathname + target.search + target.hash);
  };
  const searchUrl = (query: string, page: number) => {
    const url = new URL(window.location.href);
    url.hash = '';
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    if (page > 1) url.searchParams.set('page', String(page));
    else url.searchParams.delete('page');
    return url.pathname + url.search;
  };
  const runSearch = async (query: string, requestedPage = 1) => {
    const request = ++generation;
    if (!status || !container) return;
    container.innerHTML = '';
    if (pager) {
      pager.hidden = true;
      pager.innerHTML = '';
    }
    if (!query.trim()) {
      status.textContent = '输入关键词开始搜索。';
      return;
    }
    status.textContent = '正在搜索…';
    try {
      let results: { title: string; url: string; excerpt: string }[] = [];
      let pagination = { page: 1, totalPages: 1, total: 0 };
      if (!/[\u3400-\u9fff]/.test(query)) {
        try {
          const pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
          const search = await pagefind.search(query);
          const batch = paginateResults<SearchMatch>(search.results, requestedPage);
          pagination = batch;
          const matches = await Promise.all(batch.items.map((result) => result.data()));
          results = matches.map((result) => ({
            title: result.meta.title || '无标题',
            url: result.url,
            excerpt: result.excerpt
          }));
        } catch {
          /* Fall back to the published article index. */
        }
      }
      if (results.length === 0) {
        indexPromise ??= fetch(`${base}search-index.json`)
          .then((response) => {
            if (!response.ok) throw new Error('Search index unavailable');
            return response.json();
          })
          .catch((error) => {
            indexPromise = undefined;
            throw error;
          });
        const matches = searchEntries(await indexPromise, query);
        const batch = paginateResults(matches, requestedPage);
        pagination = batch;
        results = batch.items.map((result) => ({ ...result, excerpt: escapeHtml(result.excerpt) }));
      }
      if (request !== generation) return;
      history.replaceState(null, '', searchUrl(query, pagination.page));
      status.textContent = `找到 ${pagination.total} 条结果。`;
      if (pager && pagination.totalPages > 1) {
        pager.innerHTML = [
          pagination.page > 1
            ? `<a rel="prev" href="${escapeHtml(searchUrl(query, pagination.page - 1))}">上一页</a>`
            : '',
          `<span>第 ${pagination.page} / ${pagination.totalPages} 页</span>`,
          pagination.page < pagination.totalPages
            ? `<a rel="next" href="${escapeHtml(searchUrl(query, pagination.page + 1))}">下一页</a>`
            : ''
        ].join('');
        pager.hidden = false;
      }
      container.innerHTML = results
        .map(
          (result) => `
        <article class="search-result">
          <h2><a href="${resultUrl(result.url, query)}">${escapeHtml(result.title)}</a></h2>
          <p>${result.excerpt}</p>
        </article>`
        )
        .join('');
    } catch {
      if (request !== generation) return;
      status.textContent = '搜索暂时不可用，请稍后重试，或从文章目录查找。';
    }
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value || '';
    history.replaceState(null, '', searchUrl(query, 1));
    void runSearch(query);
  });
  const params = new URLSearchParams(window.location.search);
  const initial = params.get('q') || '';
  const initialPage = Number(params.get('page')) || 1;
  if (input) input.value = initial;
  if (initial) void runSearch(initial, initialPage);
</script>
