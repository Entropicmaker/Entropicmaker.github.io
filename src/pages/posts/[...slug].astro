---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidRenderer from '../../components/MermaidRenderer.astro';
import '../../styles/article-widgets.css';
import {
  formatDate,
  getCategory,
  getPostSlug,
  getPublishedPosts,
  getReadingTime,
  tagToSlug
} from '../../utils/posts';
import { withBase } from '../../utils/site';

export async function getStaticPaths() {
  return getPublishedPosts(await getCollection('posts')).map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post }
  }));
}
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = getCategory(post.data.category);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const hasMermaid = /```mermaid(?:\s|$)/i.test(post.body ?? '');
const returnHref = withBase(`/posts/#post-${getPostSlug(post)}`);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  article
>
  <article class="shell article-shell">
    <nav class="breadcrumb" aria-label="文章位置" data-pagefind-ignore>
      <ol>
        <li><a href={returnHref} data-return-link>返回文章目录</a></li>
        <li>
          <span aria-hidden="true">/</span><a href={withBase(`/posts/#${category.id}`)}
            >{category.name}</a>
        </li>
      </ol>
    </nav>
    <header class="article-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <div class="article-meta" data-pagefind-ignore>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
        <span>约 {getReadingTime(post)} 分钟</span>
        {post.data.series && <span>{post.data.series}</span>}
      </div>
      <p class="article-description">{post.data.description}</p>
    </header>
    {
      tocHeadings.length > 0 && (
        <details class="article-toc" data-pagefind-ignore>
          <summary>本文目录</summary>
          <nav class="toc" aria-label="文章目录">
            <ol>
              {tocHeadings.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )
    }
    <div class="article-content">
      <Content />
      {hasMermaid && <MermaidRenderer />}
    </div>
    {
      post.data.tags.length > 0 && (
        <nav class="article-tags" aria-label="文章标签" data-pagefind-ignore>
          {post.data.tags.map((tag) => (
            <a href={withBase(`/tags/${tagToSlug(tag)}/`)}>#{tag}</a>
          ))}
        </nav>
      )
    }
    {
      post.data.references && post.data.references.length > 0 && (
        <section class="references" aria-labelledby="references-title">
          <h2 id="references-title">参考资料</h2>
          <ol>
            {post.data.references.map((reference) => (
              <li>
                <a href={reference.url} target="_blank" rel="noopener noreferrer">
                  {reference.title}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
    <nav class="article-return" aria-label="返回目录" data-pagefind-ignore>
      <a href={returnHref} data-return-link>返回文章目录</a>
    </nav>
  </article>
</BaseLayout>

<script>
  import { getReturnDestination } from '../../utils/navigation';
  const destination = getReturnDestination(window.location.href, import.meta.env.BASE_URL);
  if (destination) {
    document.querySelectorAll<HTMLAnchorElement>('[data-return-link]').forEach((link) => {
      link.href = destination.href;
      link.textContent = destination.label;
    });
  }
</script>
