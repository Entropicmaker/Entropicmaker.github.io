---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../utils/site';
import ArticleIndex from '../../components/ArticleIndex.astro';
import { getPublishedPosts } from '../../utils/posts';
const posts = getPublishedPosts(await getCollection('posts'));
---

<PageLayout title="文章" description={`共 ${posts.length} 篇，按主题整理。`}>
  <ArticleIndex posts={posts} />
  <p class="index-links">
    <a href={withBase('/archive/')}>按时间浏览</a> · <a href={withBase('/tags/')}>标签索引</a>
  </p>
</PageLayout>
